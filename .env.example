# Template for `.env`. Copy to `.env` and fill in. `.env` is gitignored.
# `bin/run` (and the gcp/ scripts via lib.sh) source this before each command.
#
# The SAME repo runs in two places — your laptop (orchestration / analysis)
# and the ephemeral TPU VM (compute) — each with its own `.env`. `gcp/
# bootstrap.sh` scp's your laptop `.env` to the VM; `gcp/launch.sh` then
# injects the VM-specific bits (LLM_CIRCUITS_DEVICE=tpu, GCS dirs) at run time.

# ─── Local / laptop ─────────────────────────────────────────────────────────

# Hugging Face token (required for gated models)
HF_TOKEN=

# Device override (blank = auto: cuda/mps/cpu). On the TPU VM launch.sh sets
# this to `tpu`; you normally leave it blank locally.
LLM_CIRCUITS_DEVICE=

# Override the base cache directory (default: <project>/.cache)
# Models go to $LLM_CIRCUITS_CACHE_DIR/models, transcoders to $LLM_CIRCUITS_CACHE_DIR/transcoders
LLM_CIRCUITS_CACHE_DIR=

# Output artifacts directory (default: <project>/artifacts). gcp/pull.sh lands here.
LLM_CIRCUITS_ARTIFACTS_DIR=

# HF-level cache overrides (only used when cache_dir is not passed explicitly)
# HF_HOME=            # leave UNSET (empty value makes huggingface_hub use ./hub !)

# ─── Cloud TPU lifecycle (gcp/ scripts) ─────────────────────────────────────
# See gcp/README.md. Runs on your laptop and drives an ephemeral TPU VM.

# Identity
CRSID=zw499

# TPU (course-managed project — COMPUTE ONLY, no durable storage here)
PROJECT_ID=dis-2026-tpu-${CRSID}
ZONE=us-east5-b
ACCELERATOR_TYPE=v6e-1
RUNTIME_VERSION=v2-alpha-tpuv6e
TPU_NAME=dis-2026-${CRSID}-tpu
QR_NAME=dis-2026-${CRSID}-qr          # queued-resource name (best-practice provisioning)
TPU_SPOT=1                            # 1 = Spot (cheap, preemptible); 0 = on-demand
# TORCH_XLA_VERSION=2.9.0             # latest torch_xla (lags torch; VM torch is downgraded to match)

# Durable storage (YOUR project + billing; survives TPU deletion)
GCS_PROJECT=myloop-2026
GCS_BUCKET=dis-2026-zw499-tpu-store   # leave EMPTY to use local-pull mode (no bucket)
# Cross-project auth for the TPU -> bucket. Pick ONE (see gcp/setup_storage.sh):
#   keyless : grant the dis default compute SA objectAdmin on the bucket (no secret on the VM)
#   key     : point this at an SA key file copied to the VM
# GOOGLE_APPLICATION_CREDENTIALS=$HOME/.gcp/sa-key.json   # [VM]

# Code sync to the VM
GIT_REMOTE=https://github.com/wdk0082/llm-circuits.git   # SSH (git@…) for a private repo
GIT_REF=main
# GIT_DEPLOY_KEY=gcp/keys/deploy_key  # read-only deploy key (private repo); scp'd to the VM by bootstrap.sh

# Durable output locations (GCS) — injected by launch.sh in bucket mode
CKPT_DIR=gs://${GCS_BUCKET}/checkpoints       # checkpoints write straight to GCS
GCS_ARTIFACTS=gs://${GCS_BUCKET}/artifacts    # synced artifacts land here

# On the TPU VM, launch.sh injects: LLM_CIRCUITS_DEVICE=tpu and
# LLM_CIRCUITS_ARTIFACTS_DIR=$HOME/scratch/artifacts (staging, synced to GCS).

# Secrets / W&B (forwarded to the VM by launch.sh if set)
# WANDB_API_KEY=
# WANDB_PROJECT=

# ─── HPC / Slurm: put uv + caches on RDS to avoid filling /home quota ────────
# Uncomment and adjust WORK to match example.sh
# WORK=$HOME/rds/hpc-work/llm
# UV_CACHE_DIR=$WORK/.cache/uv
# UV_PROJECT_ENVIRONMENT=$WORK/.venvs/llm
# WANDB_DIR=$WORK/.cache/wandb
# XDG_CACHE_HOME=$WORK/.cache

# Optional: reduce chatty tokenizers warnings
# TOKENIZERS_PARALLELISM=false

# Hugging Face token (required for gated models)
HF_TOKEN=

# Override the base cache directory (default: <project>/.cache)
# Models go to $LLM_CIRCUITS_CACHE_DIR/models, transcoders to $LLM_CIRCUITS_CACHE_DIR/transcoders
LLM_CIRCUITS_CACHE_DIR=

# HF-level cache overrides (only used when cache_dir is not passed explicitly)
HF_HOME=

# Device override (e.g. cuda, cpu, mps)
LLM_CIRCUITS_DEVICE=

# --- HPC: put uv + caches on RDS to avoid filling /home quota ---
# Uncomment and adjust WORK to match example.sh
# WORK=$HOME/rds/hpc-work/llm
# PATH=$HOME/.local/bin:$PATH
# UV_CACHE_DIR=$WORK/.cache/uv
# UV_PROJECT_ENVIRONMENT=$WORK/.venvs/llm
# WANDB_DIR=$WORK/.cache/wandb
# XDG_CACHE_HOME=$WORK/.cache

# Optional: reduce chatty tokenizers warnings
# TOKENIZERS_PARALLELISM=false
